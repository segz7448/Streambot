# Copy to .env and fill in. .env is gitignored; never commit secrets.
NOVA_ENVIRONMENT=development
NOVA_DATA_DIR=data
NOVA_LOG_DIR=logs
NOVA_DB_PATH=data/nova.db
NOVA_LOG_LEVEL=INFO
NOVA_HEALTH_HOST=127.0.0.1
NOVA_HEALTH_PORT=8790

# Rolling buffer
NOVA_BUFFER_SEGMENT_SECONDS=5
NOVA_BUFFER_PRE_EVENT_SECONDS=30
NOVA_BUFFER_POST_EVENT_SECONDS=30
NOVA_BUFFER_MAX_STORAGE_MB=2048

# Resource limits (AGT-tuned)
NOVA_MAX_CONCURRENT_FFMPEG=1
NOVA_MAX_CONCURRENT_AI_JOBS=1
NOVA_PROCESSING_RESOLUTION=640x360

# Secrets (leave empty until the relevant phase; never commit real values)
NOVA_TELEGRAM_BOT_TOKEN=
NOVA_TELEGRAM_ADMIN_IDS=
NOVA_TWITCH_CLIENT_ID=
NOVA_TWITCH_CLIENT_SECRET=
NOVA_API_AUTH_TOKEN=
